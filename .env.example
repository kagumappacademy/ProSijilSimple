# Untuk pembangunan localhost. TUKAR kepada string rawak panjang sebelum production.
PORT=4000
NODE_ENV=development
JWT_SECRET=GANTIKAN_DENGAN_STRING_RAWAK_PANJANG_SEKURANG_KURANGNYA_32_AKSARA
# PORTAL_URL ialah alamat awam untuk pautan pengesahan PDF sijil.
PORTAL_URL=http://localhost:5173
# Simpan fail dan SQLite di lokasi persisten (volume) untuk deployment.
DATA_DIR=./server/data

# ==============================================================================
# Sambungan Pangkalan Data Turso (libSQL Cloud Database)
# Dapatkan URL dan Auth Token percuma di https://turso.tech
# Jika dibiarkan kosong, sistem secara automatik menggunakan fail SQLite tempatan.
# ==============================================================================
TURSO_DATABASE_URL=libsql://prosijil-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
