{
  "name": "prosijil-full-system",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "admin:create": "npm run admin:create -w server --",
    "demo:seed": "npm run demo:seed -w server",
    "test": "npm run test -w server",
    "turso:check": "npm run turso:check -w server",
    "turso:push": "npm run turso:push -w server",
    "turso:pull": "npm run turso:pull -w server"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": "22.x"
  }
}
